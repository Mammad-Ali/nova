<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- The network scan asks each device its name over UDP (unicast mDNS
	     and NetBIOS). Binding the reply socket counts as "server" in the
	     sandbox: with the client entitlement alone bind() fails with
	     EPERM, and every device came out nameless in release builds while
	     debug builds, which carry this entitlement, worked. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Saving the result image and CSV to a user-chosen location -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- What the widgets show is written to this folder (WidgetStore in
	     MainFlutterWindow.swift). App groups would be the usual way, but
	     they need a paid Apple developer team; this exception works with
	     Nova's own signature. The widget extension may only read it. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
	<array>
		<string>/Library/Application Support/Nova/</string>
	</array>
</dict>
</plist>
