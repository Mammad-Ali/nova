<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Nova runs outside the App Sandbox (since 1.5). Inside it, the
	     system hides what Nova is for: which apps use the network (nettop
	     sees only Nova itself) and the ARP table that lists every device on
	     the network (arp prints nothing). Nova isn't sold through the App
	     Store, the one place the sandbox is required. The widget extension
	     stays sandboxed: macOS loads no widget that isn't.
	     Settings and history kept in the old container are carried over on
	     the first launch (SandboxMigration in MainFlutterWindow.swift). -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
